# Exemple de configuration. NE JAMAIS mettre de vraies clés dans un fichier du dépôt.
# Dans GitHub, ces valeurs vont dans Settings > Secrets and variables > Actions.
# Pour un essai en local sur ton PC, exporte-les dans ton terminal (jamais dans un fichier commité).

# --- SECRETS (onglet Secrets) ---
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxx
NOTION_DATA_SOURCE_ID=13de520e-2ab8-4263-b80b-14e416a4d28a
CADRAGE_CLAUDE_PAGE_ID=4154b942-9217-81ad-9a54-d60129b2b9d0
CADRAGE_ARCHIE_PAGE_ID=4154b942-9217-8111-b275-eee82d46294a
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx

# --- VARIABLES (onglet Variables) ---
# Identifiants exacts des modèles, à vérifier dans la console de chaque fournisseur.
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=A_REMPLIR_AVEC_L_IDENTIFIANT_EXACT_DU_MODELE_GPT

# Prix en dollars par MILLION de tokens, à relever sur la page de tarifs officielle
# de chaque fournisseur le jour de l'installation. Sans eux, le script refuse de tourner.
PRICE_ANTHROPIC_IN=A_REMPLIR
PRICE_ANTHROPIC_OUT=A_REMPLIR
PRICE_OPENAI_IN=A_REMPLIR
PRICE_OPENAI_OUT=A_REMPLIR

# Plafonds (valeurs prudentes par défaut si laissés vides)
MAX_MONTHLY_USD=5
MAX_CALL_USD=0.5
# Marge de securite appliquee au cout estime AVANT chaque appel (heuristique de tokens).
COST_MARGIN=1.25
MAX_TURNS=3
MAX_OUTPUT_TOKENS=4000
CONTEXT_PASSES=6
MAX_CHARS_PER_PASS=6000

# Optionnel : effort de raisonnement du modèle GPT (low, medium, high), si ton modèle le gère.
# OPENAI_REASONING_EFFORT=low

# Mode essai : 1 = aucun appel de modèle ni écriture (par défaut). Passer à 0 pour le réel.
DRY_RUN=1

# Arrêt d'urgence : mettre 1 pour que le script ne fasse plus rien.
# ATELIER_PAUSE=1

# Version de l'API Notion (à ne changer qu'en cas d'erreur de version).
# NOTION_VERSION=2025-09-03
